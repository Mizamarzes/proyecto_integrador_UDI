db.url=jdbc:oracle:thin:@localhost:1522:XE
db.usuario=nombre_user
db.contrasena=contrasena

# Opcional. Si la aplicación se conecta con un usuario que no es el dueño de
# las tablas (<esquema>_app, creado por docs/db/seguridad/usuarios_roles.sql),
# aquí va el dueño: la conexión hace ALTER SESSION SET CURRENT_SCHEMA.
#   db.usuario=ENPH_APP
#   db.contrasena=ENPH_APP
#   db.esquema=ENPH
db.esquema=

# Opcional. Esquema central al que el botón «Sincronizar aprobadas» del
# módulo Verificación envía las encuestas APROBADAS (procedimiento
# <destino>.pr_sincronizar_aprobadas, se instala con docs/sql-creaciones-servidor-udi/db-destino/).
# Vacío = la sincronización avisa que no está configurada.
#   db.esquemaDestino=ENPH_CENTRAL
db.esquemaDestino=
