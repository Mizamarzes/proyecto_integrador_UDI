<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import com.udi.componentes.Paginador?>
<?import com.udi.componentes.SelectBuscable?>

<!-- Listado de encuestas: «Mis Encuestas» para el encuestador y vista global para los demás roles -->
<VBox spacing="18.0" xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.udi.controller.encuestas.EncuestaController">

   <!-- Título -->
   <HBox alignment="CENTER_LEFT">
      <VBox spacing="4.0">
         <Label fx:id="lblTitulo" text="Encuestas" styleClass="titulo-pagina" />
         <Label fx:id="lblSubtitulo" text="Consulta, seguimiento y supervisión de encuestas." styleClass="subtitulo-pagina" />
      </VBox>
      <Region HBox.hgrow="ALWAYS" />
      <Button fx:id="btnNueva" text="+ Nueva encuesta" onAction="#nuevaEncuesta" styleClass="boton-accion" />
   </HBox>

   <!-- Filtros: texto y ubicación arriba; estado, periodo, fecha de creación y total abajo -->
   <VBox styleClass="tarjeta" spacing="14.0">
      <HBox alignment="BOTTOM_LEFT" spacing="20.0">
         <VBox spacing="4.0" HBox.hgrow="SOMETIMES">
            <Label text="Buscar" styleClass="etiqueta-campo" />
            <TextField fx:id="txtBuscar" promptText="Código, hogar, dirección…" styleClass="campo-linea" prefWidth="220.0" minWidth="120.0" />
         </VBox>
         <VBox spacing="4.0" HBox.hgrow="SOMETIMES">
            <Label text="Región" styleClass="etiqueta-campo" />
            <SelectBuscable fx:id="cmbRegion" prefWidth="150.0" maxWidth="Infinity" />
         </VBox>
         <VBox spacing="4.0" HBox.hgrow="SOMETIMES">
            <Label text="Departamento" styleClass="etiqueta-campo" />
            <SelectBuscable fx:id="cmbDepartamento" prefWidth="170.0" maxWidth="Infinity" />
         </VBox>
         <VBox spacing="4.0" HBox.hgrow="SOMETIMES">
            <Label text="Municipio" styleClass="etiqueta-campo" />
            <SelectBuscable fx:id="cmbMunicipio" prefWidth="170.0" maxWidth="Infinity" />
         </VBox>
      </HBox>
      <HBox alignment="BOTTOM_LEFT" spacing="20.0">
         <VBox spacing="4.0">
            <Label text="Estado" styleClass="etiqueta-campo" />
            <ComboBox fx:id="cmbEstado" styleClass="combo-linea" prefWidth="150.0" />
         </VBox>
         <VBox fx:id="boxPeriodo" spacing="4.0">
            <Label text="Periodo" styleClass="etiqueta-campo" />
            <ComboBox fx:id="cmbPeriodo" styleClass="combo-linea" prefWidth="200.0" />
         </VBox>
         <VBox spacing="4.0">
            <Label text="Creada desde" styleClass="etiqueta-campo" />
            <DatePicker fx:id="dtpDesde" promptText="dd/mm/aaaa" styleClass="campo-fecha" prefWidth="150.0" />
         </VBox>
         <VBox spacing="4.0">
            <Label text="Creada hasta" styleClass="etiqueta-campo" />
            <DatePicker fx:id="dtpHasta" promptText="dd/mm/aaaa" styleClass="campo-fecha" prefWidth="150.0" />
         </VBox>
         <Button text="Limpiar" onAction="#limpiar" styleClass="boton-secundario" minWidth="-Infinity" />
         <Region HBox.hgrow="ALWAYS" />
         <Label fx:id="lblTotal" styleClass="texto-suave" minWidth="-Infinity" />
      </HBox>
   </VBox>

   <!-- Tabla paginada: el pie es el mismo de «Rendimiento por encuestador» en Reportes -->
   <VBox VBox.vgrow="ALWAYS">
      <TableView fx:id="tabla" styleClass="tabla" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="colId" text="ID encuesta" styleClass="columna-codigo" />
            <TableColumn fx:id="colHogar" text="Hogar / Dirección" />
            <TableColumn fx:id="colRegion" text="Región" />
            <TableColumn fx:id="colDepartamento" text="Departamento" />
            <TableColumn fx:id="colMunicipio" text="Municipio" />
            <TableColumn fx:id="colEncuestador" text="Encuestador" />
            <TableColumn fx:id="colEstado" text="Estado" />
            <TableColumn fx:id="colFecha" text="Fecha de inicio" />
            <TableColumn fx:id="colCreacion" text="Fecha de creación" />
            <TableColumn fx:id="colAvance" text="Avance (14 días)" sortable="false" />
            <TableColumn fx:id="colAcciones" text="Acciones" sortable="false" />
         </columns>
      </TableView>
      <Paginador fx:id="paginador" />
   </VBox>
</VBox>
