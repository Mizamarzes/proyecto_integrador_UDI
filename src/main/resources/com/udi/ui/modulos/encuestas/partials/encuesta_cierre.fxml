<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Pestaña «Cierre (Cap. D)»: preguntas D2, resultado A.18, verificación y cierre del caso (RF-06) -->
<VBox spacing="18.0" xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.udi.controller.EncuestaCierreController">

   <fx:define>
      <ToggleGroup fx:id="grupoFiestas" />
      <ToggleGroup fx:id="grupoPago" />
   </fx:define>

   <VBox fx:id="boxCerrada" styleClass="banner-cerrado" spacing="2.0">
      <Label fx:id="lblCerrada" styleClass="dato-valor" style="-fx-text-fill: white;" />
      <Label text="La encuesta está en solo lectura: no admite visitas, capítulo C, gastos ni comidas. Solo un administrador puede reabrirla."
             wrapText="true" style="-fx-text-fill: #d7dde5; -fx-font-size: 12px;" />
   </VBox>

   <HBox spacing="18.0" alignment="TOP_LEFT">
      <!-- D2 y A.18 -->
      <VBox styleClass="tarjeta" spacing="18.0" HBox.hgrow="ALWAYS" maxWidth="Infinity" minWidth="420.0">
         <HBox alignment="CENTER_LEFT">
            <VBox spacing="2.0">
               <Label text="D2. Preguntas al recoger el cuadernillo" styleClass="titulo-seccion" />
               <Label text="Se hacen el día en que se recoge el cuadernillo diligenciado." styleClass="texto-suave" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Label text="CAPÍTULO D" styleClass="chip" />
         </HBox>

         <VBox fx:id="formulario" spacing="18.0">
            <VBox spacing="8.0">
               <Label wrapText="true" styleClass="dato-valor"
                      text="1. Durante los catorce días en que se registró la información, ¿el hogar tuvo algún gasto en alimentos debido a fiestas, reuniones o invitados? *" />
               <HBox spacing="10.0">
                  <RadioButton fx:id="rbFiestasSi" text="Sí (1)" toggleGroup="$grupoFiestas" styleClass="radio-tarjeta" prefWidth="140.0" />
                  <RadioButton fx:id="rbFiestasNo" text="No (2)" toggleGroup="$grupoFiestas" styleClass="radio-tarjeta" prefWidth="140.0" />
               </HBox>
            </VBox>

            <VBox spacing="8.0">
               <Label wrapText="true" styleClass="dato-valor"
                      text="2. La principal forma de pago usada para comprar los bienes mencionados en este cuadernillo fue: *" />
               <GridPane fx:id="gridPago" hgap="10.0" vgap="10.0">
                  <columnConstraints>
                     <ColumnConstraints percentWidth="33.3" />
                     <ColumnConstraints percentWidth="33.3" />
                     <ColumnConstraints percentWidth="33.4" />
                  </columnConstraints>
               </GridPane>
               <VBox fx:id="boxOtra" spacing="4.0" maxWidth="420.0">
                  <Label text="f. Otra, ¿cuál? *" styleClass="etiqueta-campo" />
                  <TextField fx:id="txtOtra" promptText="Ej. transferencia por Nequi" styleClass="campo-linea" />
               </VBox>
            </VBox>

            <VBox spacing="4.0">
               <Label text="Observaciones" styleClass="etiqueta-campo" />
               <TextArea fx:id="txtObservaciones" prefRowCount="3" wrapText="true" styleClass="area-texto"
                         promptText="Novedades del periodo, aclaraciones del informante…" />
               <HBox alignment="CENTER_RIGHT">
                  <Label fx:id="lblCaracteres" styleClass="texto-suave" />
               </HBox>
            </VBox>

            <VBox styleClass="caja-suave" spacing="6.0">
               <Label text="Resultado del cuadernillo (A.18) *" styleClass="etiqueta-campo" />
               <ComboBox fx:id="cmbResultado" promptText="Seleccione" styleClass="combo-linea" prefWidth="320.0" />
               <Label text="Va en la portada del cuadernillo. «EC - Encuesta completa» cuando el hogar registró los 14 días."
                      wrapText="true" styleClass="texto-suave" />
            </VBox>
         </VBox>

         <Label fx:id="lblError" styleClass="banner-error" wrapText="true" maxWidth="Infinity" />

         <HBox fx:id="boxBotones" spacing="10.0" alignment="CENTER_RIGHT" style="-fx-border-color: #e6dfd2 transparent transparent transparent; -fx-padding: 14 0 0 0;">
            <Button text="Descartar cambios" onAction="#descartar" styleClass="boton-secundario" />
            <Button text="Guardar respuestas" onAction="#guardar" styleClass="boton-primario" />
         </HBox>
      </VBox>

      <!-- Verificación y cierre -->
      <VBox spacing="18.0" prefWidth="340.0" minWidth="300.0" maxWidth="380.0">
         <VBox styleClass="tarjeta" spacing="12.0">
            <HBox alignment="CENTER_LEFT">
               <Label text="Verificación del caso" styleClass="titulo-seccion" />
               <Region HBox.hgrow="ALWAYS" />
               <Label fx:id="lblVerificados" styleClass="dato-valor" />
            </HBox>
            <ProgressBar fx:id="barVerificacion" styleClass="barra" maxWidth="Infinity" progress="0.0" />
            <VBox fx:id="listaChequeos" />
         </VBox>

         <VBox fx:id="boxCerrar" styleClass="tarjeta,tarjeta-acento" spacing="12.0">
            <Label text="Cerrar el caso" styleClass="titulo-seccion" />
            <Label wrapText="true" styleClass="texto-suave"
                   text="Al cerrar, la encuesta queda en solo lectura: ya no se pueden registrar visitas, capítulo C, gastos ni comidas. Solo un administrador puede reabrirla." />
            <Label fx:id="lblFaltan" styleClass="banner-alerta" wrapText="true" maxWidth="Infinity" />
            <Button fx:id="btnCerrar" text="Cerrar caso" onAction="#cerrarCaso" styleClass="boton-accion" maxWidth="Infinity" />
         </VBox>

         <VBox fx:id="boxCerrado" styleClass="tarjeta" spacing="12.0">
            <Label text="Caso cerrado" styleClass="titulo-seccion" />
            <GridPane hgap="18.0" vgap="10.0">
               <columnConstraints>
                  <ColumnConstraints percentWidth="50.0" />
                  <ColumnConstraints percentWidth="50.0" />
               </columnConstraints>
               <VBox spacing="2.0">
                  <Label text="Fecha de cierre" styleClass="dato-etiqueta" />
                  <Label fx:id="lblFechaCierre" styleClass="dato-valor" wrapText="true" />
               </VBox>
               <VBox spacing="2.0" GridPane.columnIndex="1">
                  <Label text="Cerrado por" styleClass="dato-etiqueta" />
                  <Label fx:id="lblCerradoPor" styleClass="dato-valor" wrapText="true" />
               </VBox>
            </GridPane>
            <Label fx:id="lblReapertura" wrapText="true" styleClass="texto-suave"
                   text="¿Hay que corregir algo? Pida la reapertura a un administrador. Al reabrirlo, el estado pasa a «Reabierta»." />
            <Button fx:id="btnReabrir" text="Reabrir caso" onAction="#reabrir" styleClass="boton-secundario" maxWidth="Infinity" />
         </VBox>
      </VBox>
   </HBox>
</VBox>
