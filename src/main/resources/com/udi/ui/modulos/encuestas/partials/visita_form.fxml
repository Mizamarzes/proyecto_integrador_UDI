<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Modal del control de visitas (capítulo B) -->
<VBox styleClass="modal" prefWidth="620.0" xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.udi.controller.encuestas.VisitaFormController">

   <VBox styleClass="modal-encabezado" spacing="4.0">
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <Label fx:id="lblTitulo" text="Registrar visita" styleClass="titulo-modal" />
         <Label fx:id="lblNumero" styleClass="chip" />
      </HBox>
      <Label fx:id="lblSubtitulo" styleClass="subtitulo-pagina" />
   </VBox>

   <VBox styleClass="modal-cuerpo" spacing="16.0">
      <GridPane hgap="20.0" vgap="14.0">
         <columnConstraints>
            <ColumnConstraints percentWidth="34.0" />
            <ColumnConstraints percentWidth="33.0" />
            <ColumnConstraints percentWidth="33.0" />
         </columnConstraints>
         <VBox spacing="4.0">
            <Label text="Fecha *" styleClass="etiqueta-campo" />
            <DatePicker fx:id="dtpFecha" promptText="dd/mm/aaaa" styleClass="campo-fecha" maxWidth="Infinity" />
         </VBox>
         <VBox spacing="4.0" GridPane.columnIndex="1">
            <Label text="Hora de inicio * (HH:mm)" styleClass="etiqueta-campo" />
            <TextField fx:id="txtInicio" promptText="09:30" styleClass="campo-linea" />
         </VBox>
         <VBox spacing="4.0" GridPane.columnIndex="2">
            <Label text="Hora de fin (HH:mm)" styleClass="etiqueta-campo" />
            <TextField fx:id="txtFin" promptText="10:15" styleClass="campo-linea" />
         </VBox>
      </GridPane>

      <VBox spacing="4.0">
         <Label text="Resultado de la visita *" styleClass="etiqueta-campo" />
         <ComboBox fx:id="cmbResultado" promptText="Seleccione" styleClass="combo-linea" maxWidth="Infinity" />
      </VBox>

      <VBox spacing="4.0">
         <Label text="Partes pendientes / observaciones (máx. 200)" styleClass="etiqueta-campo" />
         <TextArea fx:id="txtPendientes" prefRowCount="3" wrapText="true" styleClass="area-texto"
                   promptText="Partes del cuadernillo que quedan pendientes, acuerdos con la informante…" />
      </VBox>

      <VBox styleClass="caja-suave" spacing="10.0">
         <Label text="PRÓXIMA CITA" styleClass="etiqueta-seccion" />
         <GridPane hgap="20.0">
            <columnConstraints>
               <ColumnConstraints percentWidth="50.0" />
               <ColumnConstraints percentWidth="50.0" />
            </columnConstraints>
            <VBox spacing="4.0">
               <Label text="Fecha" styleClass="etiqueta-campo" />
               <DatePicker fx:id="dtpProxima" promptText="dd/mm/aaaa" styleClass="campo-fecha" maxWidth="Infinity" />
            </VBox>
            <VBox spacing="4.0" GridPane.columnIndex="1">
               <Label text="Hora (HH:mm)" styleClass="etiqueta-campo" />
               <TextField fx:id="txtHoraProxima" promptText="16:00" styleClass="campo-linea" />
            </VBox>
         </GridPane>
      </VBox>

      <Label fx:id="lblError" styleClass="banner-error" wrapText="true" maxWidth="Infinity" />
   </VBox>

   <HBox styleClass="modal-pie" spacing="10.0" alignment="CENTER_RIGHT">
      <Button text="Cancelar" onAction="#cancelar" styleClass="boton-secundario" />
      <Button fx:id="btnGuardar" text="Guardar visita" onAction="#guardar" styleClass="boton-primario" />
   </HBox>
</VBox>
