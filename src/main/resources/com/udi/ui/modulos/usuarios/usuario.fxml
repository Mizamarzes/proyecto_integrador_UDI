<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0" xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.udi.controller.UsuarioController">

   <!-- Título -->
   <HBox alignment="CENTER_LEFT">
      <VBox spacing="4.0">
         <Label text="Usuarios" styleClass="titulo-pagina" />
         <Label text="Roles, permisos y estado de acceso." styleClass="subtitulo-pagina" />
      </VBox>
      <Region HBox.hgrow="ALWAYS" />
      <Button text="+ Nuevo usuario" onAction="#nuevoUsuario" styleClass="boton-accion" />
   </HBox>

   <!-- Filtros -->
   <HBox styleClass="tarjeta" alignment="BOTTOM_LEFT" spacing="20.0">
      <VBox spacing="4.0">
         <Label text="Buscar" styleClass="etiqueta-campo" />
         <TextField fx:id="txtBuscar" promptText="Nombre o correo…" styleClass="campo-linea" prefWidth="200.0" minWidth="120.0" />
      </VBox>
      <VBox spacing="4.0">
         <Label text="Rol" styleClass="etiqueta-campo" />
         <ComboBox fx:id="cmbRol" styleClass="combo-linea" prefWidth="180.0" />
      </VBox>
      <Button text="Limpiar" onAction="#limpiar" styleClass="boton-secundario" minWidth="-Infinity" />
      <Region HBox.hgrow="ALWAYS" />
      <Label fx:id="lblTotal" styleClass="texto-suave" minWidth="-Infinity" />
   </HBox>

   <!-- Tabla -->
   <TableView fx:id="tabla" styleClass="tabla" VBox.vgrow="ALWAYS">
      <columns>
         <TableColumn fx:id="colNombre" text="Nombre" />
         <TableColumn fx:id="colCorreo" text="Correo" styleClass="columna-codigo" />
         <TableColumn fx:id="colRol" text="Rol" />
         <TableColumn fx:id="colEstado" text="Estado" />
         <TableColumn fx:id="colAcciones" text="Acciones" sortable="false" />
      </columns>
   </TableView>
</VBox>
