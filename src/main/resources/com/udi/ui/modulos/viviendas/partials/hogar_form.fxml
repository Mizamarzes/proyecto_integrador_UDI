<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Modal «Agregar hogar» / «Editar hogar» (A.9, A.13 y A.14) -->
<VBox styleClass="modal" prefWidth="480.0" xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.udi.controller.HogarFormController">

   <VBox styleClass="modal-encabezado" spacing="4.0">
      <Label fx:id="lblTitulo" text="Agregar hogar" styleClass="titulo-modal" />
      <Label fx:id="lblSubtitulo" styleClass="subtitulo-pagina" wrapText="true" />
   </VBox>

   <VBox styleClass="modal-cuerpo" spacing="16.0">
      <VBox spacing="4.0">
         <Label text="Hogar número (A.13) *" styleClass="etiqueta-campo" />
         <ComboBox fx:id="cmbNumero" promptText="Seleccione" styleClass="combo-linea" maxWidth="Infinity" />
         <Label fx:id="lblNotaNumero" styleClass="texto-suave" wrapText="true" />
      </VBox>
      <VBox spacing="4.0">
         <Label text="Total de personas en el hogar (A.14) *" styleClass="etiqueta-campo" />
         <TextField fx:id="txtPersonas" promptText="Ej. 3" styleClass="campo-linea" />
      </VBox>
      <VBox spacing="4.0">
         <Label text="Ciclo (A.9)" styleClass="etiqueta-campo" />
         <TextField fx:id="txtCiclo" promptText="Ej. 04" styleClass="campo-linea" />
         <Label text="Quincena del operativo." styleClass="texto-suave" />
      </VBox>
      <Label fx:id="lblError" styleClass="banner-error" wrapText="true" maxWidth="Infinity" />
   </VBox>

   <HBox styleClass="modal-pie" spacing="10.0" alignment="CENTER_RIGHT">
      <Button text="Cancelar" onAction="#cancelar" styleClass="boton-secundario" />
      <Button fx:id="btnGuardar" text="Guardar hogar" onAction="#guardar" styleClass="boton-primario" />
   </HBox>
</VBox>
