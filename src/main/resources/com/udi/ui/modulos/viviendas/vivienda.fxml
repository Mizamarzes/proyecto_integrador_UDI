<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Listado de viviendas con el avance de sus hogares (capítulo A) -->
<VBox spacing="18.0" xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.udi.controller.ViviendaController">

   <HBox alignment="CENTER_LEFT" spacing="12.0">
      <VBox spacing="4.0" HBox.hgrow="ALWAYS">
         <Label text="Viviendas y hogares" styleClass="titulo-pagina" />
         <Label text="Registra las viviendas de tu sector (Capítulo A) y sus hogares. Las encuestas se crean después desde Encuestas, seleccionando un hogar."
                styleClass="subtitulo-pagina" wrapText="true" />
      </VBox>
      <Button fx:id="btnNueva" text="+ Nueva vivienda" onAction="#nuevaVivienda" styleClass="boton-accion" minWidth="-Infinity" />
   </HBox>

   <HBox fx:id="boxAviso" styleClass="banner-ok" alignment="CENTER_LEFT" spacing="6.0">
      <Label fx:id="lblAviso" style="-fx-text-fill: #2f5e3d;" />
      <Hyperlink text="Agregar sus hogares" onAction="#abrirNueva" />
   </HBox>

   <HBox styleClass="tarjeta" alignment="BOTTOM_LEFT" spacing="20.0">
      <VBox spacing="4.0">
         <Label text="Buscar" styleClass="etiqueta-campo" />
         <TextField fx:id="txtBuscar" promptText="Código, dirección o barrio…" styleClass="campo-linea" prefWidth="220.0" minWidth="120.0" />
      </VBox>
      <VBox spacing="4.0">
         <Label text="Hogares" styleClass="etiqueta-campo" />
         <ComboBox fx:id="cmbFiltro" styleClass="combo-linea" prefWidth="230.0" />
      </VBox>
      <Button text="Limpiar" onAction="#limpiar" styleClass="boton-secundario" minWidth="-Infinity" />
      <Region HBox.hgrow="ALWAYS" />
      <Label fx:id="lblTotal" styleClass="texto-suave" minWidth="-Infinity" />
   </HBox>

   <TableView fx:id="tabla" styleClass="tabla" VBox.vgrow="ALWAYS">
      <columns>
         <TableColumn fx:id="colCodigo" text="Vivienda" styleClass="columna-codigo" prefWidth="90.0" />
         <TableColumn fx:id="colDireccion" text="Dirección / Barrio" prefWidth="220.0" />
         <TableColumn fx:id="colCartografia" text="Ubicación cartográfica" prefWidth="150.0" />
         <TableColumn fx:id="colHogares" text="Hogares (A.12)" prefWidth="160.0" sortable="false" />
         <TableColumn fx:id="colEncuestas" text="Encuestas" prefWidth="150.0" />
         <TableColumn fx:id="colAcciones" text="Acciones" prefWidth="110.0" sortable="false" />
      </columns>
   </TableView>

   <Label text="Un hogar solo puede tener una encuesta. Los hogares sin encuesta aparecen al crear una nueva encuesta." styleClass="texto-suave" wrapText="true" />
</VBox>
