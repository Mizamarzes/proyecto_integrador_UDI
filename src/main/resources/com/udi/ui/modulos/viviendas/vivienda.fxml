<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import com.udi.componentes.SelectBuscable?>

<!-- Listado de viviendas con el avance de sus hogares (capítulo A) -->
<VBox spacing="18.0" xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.udi.controller.viviendas.ViviendaController">

   <HBox alignment="CENTER_LEFT" spacing="12.0">
      <VBox spacing="4.0" HBox.hgrow="ALWAYS">
         <Label text="Viviendas y hogares" styleClass="titulo-pagina" />
         <Label text="Registra las viviendas de tu sector (Capítulo A) y sus hogares. Las encuestas se crean después desde Encuestas, seleccionando un hogar."
                styleClass="subtitulo-pagina" wrapText="true" />
      </VBox>
      <Button fx:id="btnNueva" text="+ Nueva vivienda" onAction="#nuevaVivienda" styleClass="boton-accion" minWidth="-Infinity" />
   </HBox>

   <HBox fx:id="boxAviso" styleClass="banner-ok" alignment="CENTER_LEFT" spacing="6.0">
      <Label fx:id="lblAviso" style="-fx-text-fill: #2f5e3d;" />
      <Hyperlink text="Agregar sus hogares" onAction="#abrirNueva" />
   </HBox>

   <!-- Filtros: texto y ubicación arriba; hogares, fecha de creación y total abajo -->
   <VBox styleClass="tarjeta" spacing="14.0">
      <HBox alignment="BOTTOM_LEFT" spacing="20.0">
         <VBox spacing="4.0" HBox.hgrow="SOMETIMES">
            <Label text="Buscar" styleClass="etiqueta-campo" />
            <TextField fx:id="txtBuscar" promptText="Código, dirección o barrio…" styleClass="campo-linea" prefWidth="200.0" minWidth="120.0" />
         </VBox>
         <VBox spacing="4.0" HBox.hgrow="SOMETIMES">
            <Label text="Región" styleClass="etiqueta-campo" />
            <SelectBuscable fx:id="cmbRegion" prefWidth="150.0" maxWidth="Infinity" />
         </VBox>
         <VBox spacing="4.0" HBox.hgrow="SOMETIMES">
            <Label text="Departamento" styleClass="etiqueta-campo" />
            <SelectBuscable fx:id="cmbDepartamento" prefWidth="170.0" maxWidth="Infinity" />
         </VBox>
         <VBox spacing="4.0" HBox.hgrow="SOMETIMES">
            <Label text="Municipio" styleClass="etiqueta-campo" />
            <SelectBuscable fx:id="cmbMunicipio" prefWidth="170.0" maxWidth="Infinity" />
         </VBox>
      </HBox>
      <HBox alignment="BOTTOM_LEFT" spacing="20.0">
         <VBox spacing="4.0">
            <Label text="Hogares" styleClass="etiqueta-campo" />
            <ComboBox fx:id="cmbFiltro" styleClass="combo-linea" prefWidth="200.0" />
         </VBox>
         <VBox spacing="4.0">
            <Label text="Creada desde" styleClass="etiqueta-campo" />
            <DatePicker fx:id="dtpDesde" promptText="dd/mm/aaaa" styleClass="campo-fecha" prefWidth="150.0" />
         </VBox>
         <VBox spacing="4.0">
            <Label text="Creada hasta" styleClass="etiqueta-campo" />
            <DatePicker fx:id="dtpHasta" promptText="dd/mm/aaaa" styleClass="campo-fecha" prefWidth="150.0" />
         </VBox>
         <Button text="Limpiar" onAction="#limpiar" styleClass="boton-secundario" minWidth="-Infinity" />
         <Region HBox.hgrow="ALWAYS" />
         <Label fx:id="lblTotal" styleClass="texto-suave" minWidth="-Infinity" />
      </HBox>
   </VBox>

   <TableView fx:id="tabla" styleClass="tabla" VBox.vgrow="ALWAYS">
      <columns>
         <TableColumn fx:id="colCodigo" text="Vivienda" styleClass="columna-codigo" prefWidth="90.0" />
         <TableColumn fx:id="colDireccion" text="Dirección / Barrio" prefWidth="200.0" />
         <TableColumn fx:id="colRegion" text="Región" prefWidth="100.0" />
         <TableColumn fx:id="colDepartamento" text="Departamento" prefWidth="120.0" />
         <TableColumn fx:id="colMunicipio" text="Municipio" prefWidth="120.0" />
         <TableColumn fx:id="colCartografia" text="Ubicación cartográfica" prefWidth="140.0" />
         <TableColumn fx:id="colHogares" text="Hogares (A.12)" prefWidth="100.0" />
         <TableColumn fx:id="colEncuestas" text="Encuestas" prefWidth="150.0" />
         <TableColumn fx:id="colCreacion" text="Fecha de creación" prefWidth="110.0" />
         <TableColumn fx:id="colAcciones" text="Acciones" prefWidth="110.0" sortable="false" />
      </columns>
   </TableView>

   <Label text="Un hogar solo puede tener una encuesta. Los hogares sin encuesta aparecen al crear una nueva encuesta." styleClass="texto-suave" wrapText="true" />
</VBox>
